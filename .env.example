# Copy this file to .env and fill in your values.
# Never commit your real .env file.
ZHIPU_API_KEY=""

# Web search (Enriched Concepts grounding). Without a key the search chain is
# disabled and the app still runs — callers just get explicit empty results.
# Prerequisite: connect Tavily and Exa in your Composio project dashboard.
COMPOSIO_API_KEY=""
# Optional comma-separated provider chain. Default: composio:tavily,composio:exa
# Unknown entries are ignored; set to empty to disable search explicitly.
WEB_SEARCH_PROVIDERS=""
